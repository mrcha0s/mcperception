{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:designsystems.surf)",
      "WebFetch(domain:hds.hel.fi)",
      "WebFetch(domain:blog.logrocket.com)",
      "WebFetch(domain:blog.uxtweak.com)",
      "WebFetch(domain:www.nngroup.com)",
      "WebFetch(domain:m1.material.io)",
      "WebFetch(domain:www.eleken.co)",
      "WebFetch(domain:m3.material.io)",
      "Read(*)",
      "Grep(*)",
      "Glob(*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(for f in mcperception-input.css mcperception-panel.css mcperception-components.css demo/index.html demo/forms.html demo/trading-card.html demo/color.html demo/components.html demo/button.html demo/badges.html)",
      "Bash(do sed -i 's/p-neutral-3000/p-neutral-300/g; s/p-red-2000/p-red-200/g; s/p-green-2000/p-green-200/g; s/p-blue-2000/p-blue-200/g; s/p-yellow-2000/p-yellow-200/g; s/p-magenta-2000/p-magenta-200/g; s/p-teal-2000/p-teal-200/g' \"$f\")",
      "Bash(echo \"Fixed: $f\")",
      "Bash(done)",
      "Read(//c/Users/melik/AppData/Local/Temp/**)",
      "Bash(node /c/Users/melik/AppData/Local/Temp/migrate-buttons.js)",
      "Bash(node /c/Users/melik/AppData/Local/Temp/wcag-audit-buttons.js)",
      "Bash(node \"C:/Users/melik/AppData/Local/Temp/wcag-audit-buttons.js\")",
      "Bash(node \"C:/Users/melik/AppData/Local/Temp/wcag-text-tiers.js\")",
      "Bash(for f in panel-system.html dark-surfaces.html forms.html getting-started.html index.html trading-card.html input.html orderbook.html button.html color.html surface-modes.html typography.html badges.html selection.html)",
      "Bash(do sed -i 's|<a href=\"\"panel-system.html\"\" class=\"\"docs-nav-link\"\" data-page=\"\"panel-system\"\">Panels</a>|<a href=\"\"table.html\"\" class=\"\"docs-nav-link\"\" data-page=\"\"table\"\">Tables</a>\\\\n            <a href=\"\"panel-system.html\"\" class=\"\"docs-nav-link\"\" data-page=\"\"panel-system\"\">Panels</a>|' \"$f\")",
      "Bash(for f in badges.html button.html input.html selection.html table.html forms.html color.html dark-surfaces.html surface-modes.html panel-system.html typography.html trading-card.html orderbook.html)",
      "Bash(do echo \"=== $f ===\" echo \"MODES:\" grep -o 'data-mode=\"\"[0-9]\"\"' \"$f\")",
      "Bash(do echo \"=== $f SIZES ===\" grep -oiE '\\\\bmc-badge-xs\\\\b|\\\\bmc-badge-sm\\\\b|\\\\bmc-badge-md\\\\b|\\\\bmc-badge-lg\\\\b|\\\\bmc-badge-xl\\\\b|\\\\bmc-badge-xxl\\\\b|\\\\bmc-btn-xs\\\\b|\\\\bmc-btn-sm\\\\b|\\\\bmc-btn-md\\\\b|\\\\bmc-btn-lg\\\\b|\\\\bmc-btn-xl\\\\b|\\\\bmc-btn-xxl\\\\b|\\\\bmc-input-xs\\\\b|\\\\bmc-input-sm\\\\b|\\\\bmc-input-md\\\\b|\\\\bmc-input-lg\\\\b|\\\\bmc-input-xl\\\\b|\\\\bmc-input-xxl\\\\b|size-xs|size-sm|size-md|size-lg|size-xl|size-xxl|data-size=\"\"xs\"\"|data-size=\"\"sm\"\"|data-size=\"\"md\"\"|data-size=\"\"lg\"\"|data-size=\"\"xl\"\"|data-size=\"\"xxl\"\"' \"$f\")",
      "Bash(do echo \"=== $f HUES ===\" grep -oiE 'data-hue=\"\"neutral\"\"|data-hue=\"\"red\"\"|data-hue=\"\"green\"\"|data-hue=\"\"blue\"\"|data-hue=\"\"yellow\"\"|data-hue=\"\"magenta\"\"|data-hue=\"\"teal\"\"' \"$f\")",
      "Bash(for f in *.html)",
      "Bash(do sed -i 's/background: rgba\\(255,255,255,0.03\\);/background: #222222;/g; s/background: rgba\\(82,82,255,0.06\\);/background: #222222;/g; s/background: rgba\\(10,10,10,0.7\\);/background: #090909;/g' \"$f\")",
      "Bash(sort -t: -k2 -u)",
      "Bash(while IFS=: read line hex)",
      "Bash(do echo \"$line:$hex\")",
      "Bash(sed 's/:$//')",
      "Read(//c/src/Perception/**)",
      "Bash(do sed -i '/<a href=\"\"badges.html\"\" class=\"\"docs-nav-link\"\" data-page=\"\"badges\"\">Badges<\\\\/a>/a\\\\                    <a href=\"\"alert.html\"\" class=\"\"docs-nav-link\"\" data-page=\"\"alert\"\">Alerts<\\\\/a>' \"$f\")",
      "Bash(npm run tw:build)",
      "Bash(npm run css:build)"
    ],
    "additionalDirectories": [
      "C:\\Users\\melik\\AppData\\Local\\Temp"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/agents/hooks/palette-guard.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "agent",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/agents/hooks/session-context.js"
          }
        ]
      }
    ]
  }
}
